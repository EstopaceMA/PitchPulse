# Optional Microsoft Foundry analysis agents. Copy to .env.local (gitignored).
# Without these values the studio keeps its local, rule-based analysis only.

# Kill switch: AI routes answer 503 "not_configured" unless this is "on".
PITCHPULSE_AI=on

# Project endpoint from the Foundry portal (Entra ID auth; no API key).
FOUNDRY_PROJECT_ENDPOINT=https://<resource-name>.services.ai.azure.com/api/projects/<project-name>

# Model deployments used by `npm run agents:provision`.
FOUNDRY_MODEL_DEPLOYMENT=gpt-5-mini
# Optional cheaper/faster deployment for the commentator agent.
# FOUNDRY_MODEL_DEPLOYMENT_FAST=gpt-5-nano

# Optional version pins printed by `npm run agents:provision`. Omit to use the latest version.
# FOUNDRY_AGENT_VERSION_ANALYST=1
# FOUNDRY_AGENT_VERSION_RECAP=1
# FOUNDRY_AGENT_VERSION_ASK=1
# FOUNDRY_AGENT_VERSION_COMMENTATOR=1

# DefaultAzureCredential: locally run `az login`. Off Azure, use a service principal:
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
